# Copy this file to .env (same folder) and fill in your values. Never commit .env.

# Your Bright Data API key. The code also accepts the name BRIGHTDATA_API_KEY.
BRIGHTDATA_API_TOKEN=

# Optional: the name of a Web Unlocker zone on your account.
# Leave it empty and the scripts pick a Web Unlocker zone from your account for you.
# (In the Bright Data zone list, Web Unlocker zones have the type "unblocker".)
BRIGHTDATA_ZONE=
